# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Exchange Rates API
BCP_API_URL="https://www.bcp.gov.py/api/tasas-cambio"
EXCHANGERATE_API_KEY="your-exchangerate-api-key"

# SIFEN (Paraguay Tax Authority)
SIFEN_API_URL="https://sifen.set.gov.py/api"
SIFEN_CERTIFICATE="base64-encoded-p12-certificate"
SIFEN_CERTIFICATE_PASS="certificate-password"

# Vercel Blob (for XML storage)
BLOB_READ_WRITE_TOKEN="your-vercel-blob-token"

# Cifra de segredos guardados na base de dados (AES-256-GCM).
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NUNCA guardar na base de dados — é isso que dá sentido ao esquema.
CONNECTION_SECRET_KEY="chave-de-32-bytes-em-base64"
TENANT_SECRET_KEY="outra-chave-de-32-bytes-em-base64"

# Domínios sob os quais um subdomínio identifica um cliente.
# Ex.: axisstore.com,axisfarm.com — em desenvolvimento, localhost.
TENANT_BASE_DOMAINS="localhost"

# Shadow database para `prisma migrate dev` (projeto Neon separado e descartável).
# O Prisma APAGA e RECRIA esta base: nunca apontar para produção.
SHADOW_DATABASE_URL="postgresql://..."

# Segredo do Vercel Cron. Sem ele, a rota /api/cron/* fica FECHADA — nunca aberta.
CRON_SECRET="gerar-com-randomBytes-24"

# Control plane — registo de clientes, em projeto Neon PRÓPRIO.
CONTROL_PLANE_DATABASE_URL="postgresql://..."
