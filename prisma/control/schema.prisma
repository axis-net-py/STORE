// ═══════════════════════════════════════════════════════════════════════════
// Control plane — registo de clientes (spec Projeto 2, §3.1)
//
// Vive num projeto Neon PRÓPRIO, separado das bases dos clientes. Guarda as
// strings de ligação de todos: se vivesse dentro da base de um cliente,
// comprometer esse cliente exporia todos os outros.
//
// NUNCA guarda dados de negócio. Só o que é preciso para encontrar e servir
// cada cliente.
// ═══════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/control"
}

datasource db {
  provider = "postgresql"
  url      = env("CONTROL_PLANE_DATABASE_URL")
}

enum TenantStatus {
  /// A ser criado. Se ficar aqui, o provisionamento falhou a meio.
  PROVISIONING
  ACTIVE
  /// Falta de pagamento. Os dados ficam INTACTOS — nunca se apaga (§7.5).
  SUSPENDED
  /// Provisionamento falhou. Requer inspeção manual; nunca limpeza automática.
  FAILED
  /// Uma migração falhou nesta base. O middleware mostra manutenção (§7.1).
  MIGRATION_FAILED
}

/// Onde vivem os dados de um cliente.
enum TenantHosting {
  /// Base partilhada, isolamento por tenantId. O arranque de qualquer cliente.
  SHARED
  /// Projeto Neon dedicado.
  DEDICATED
}

model TenantRegistry {
  id String @id @default(cuid())

  /// Subdomínio: `smartbuy` → smartbuy.axisstore.com. Espelha Tenant.slug.
  slug String @unique
  name String

  /// Id do tenant na base onde os dados vivem. Com hospedagem partilhada é o
  /// discriminador de todas as queries; com dedicada, continua a existir —
  /// é o seguro que permite consolidar clientes sem reescrever o ERP (D5).
  tenantId String

  hosting TenantHosting @default(SHARED)
  status  TenantStatus  @default(PROVISIONING)

  /// Projeto Neon do cliente, quando a hospedagem é dedicada.
  /// Gravado ANTES de qualquer passo que possa falhar: sem isto, uma
  /// reexecução criaria um segundo projeto e deixaria o primeiro órfão (§5.2).
  neonProjectId String?

  /// String de ligação, cifrada com AES-256-GCM (chave CONNECTION_SECRET_KEY).
  /// Nula com hospedagem partilhada: nesse caso usa-se a ligação do ambiente.
  connectionCipher String?
  connectionIv     String?
  connectionTag    String?

  /// Vertical comercial: store, farm, clinic, food.
  vertical String @default("store")
  /// Módulos contratados. Informação comercial — por isso vive aqui.
  modules  String[] @default(["store"])

  /// Última migração aplicada nesta base. Permite ver quem está atrasado.
  schemaVersion String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventos ProvisioningEvent[]

  @@index([status])
  @@index([hosting])
}

/// Registo do que aconteceu a cada cliente. O provisionamento cria recursos
/// fora da nossa base (projetos Neon) e essa história tem de ficar escrita.
model ProvisioningEvent {
  id       String         @id @default(cuid())
  tenantId String
  tenant   TenantRegistry @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  step    String
  ok      Boolean
  detalhe Json?

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

/// Onde procurar um e-mail no momento do login.
///
/// Com base partilhada isto não fazia falta: `User.email` é único e a consulta
/// encontrava a pessoa. Com base dedicada há um problema de ovo e galinha —
/// para saber a base é preciso saber o cliente, e para saber o cliente é
/// preciso ler o utilizador, que está na base que ainda não se sabe qual é.
///
/// Esta tabela quebra o ciclo, e é a ÚNICA razão para existir. Guarda o e-mail
/// e nada mais: nem nome, nem papel, nem palavra-passe. A palavra-passe nunca
/// sai da base do cliente, que é onde tem de estar — este registo diz apenas
/// "procure ali".
model UserDirectory {
  id String @id @default(cuid())

  /// Normalizado em minúsculas antes de gravar, como no `authorize`.
  email String @unique

  /// Registo do cliente onde este utilizador vive.
  registryId String
  /// Espelhado para o login não precisar de segunda consulta.
  tenantId   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([registryId])
}
