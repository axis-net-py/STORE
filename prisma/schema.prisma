generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  // Usado APENAS por `prisma migrate dev`, em desenvolvimento local.
  // `prisma generate`, `migrate deploy` e o runtime não lhe tocam — por isso a
  // variável não precisa de existir no Vercel. Ver docs/superpowers/plans, Etapa 4.
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────

enum Role {
  SOVEREIGN
  ADMIN
  OPERATOR
  AUDITOR
}

enum Currency {
  PYG
  USD
  BRL
}

enum TransactionType {
  RECEIVABLE
  PAYABLE
  TRANSFER
}

enum InvoiceType {
  PURCHASE
  SALES
}

enum InvoiceStatus {
  DRAFT
  APPROVED
  CANCELLED
  PENDING
}

enum MovementType {
  ENTRADA
  SAIDA
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHECK
  CARD
  OTHER
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum TaxType {
  IVA_10
  IVA_5
  EXENTO
}

// ─── Tenant ─────────────────────────────────────────────────

model Tenant {
  id               String   @id @default(cuid())
  name             String
  /// Módulos ativos deste cliente. O vertical (store/farm/clinic/food) é um
  /// conjunto nomeado destes — ver src/modules/registry.ts. Todas as bases têm
  /// as tabelas de todos os módulos; só esta lista difere (spec Projeto 1, D4).
  modules          String[] @default(["store"])
  businessName     String?
  ruc              String?
  tradeName        String?
  establishment    String?  @default("001")
  emissionPoint    String?  @default("001")
  address          String?
  economicActivity String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users             User[]
  customers         Customer[]
  suppliers         Supplier[]
  products          Product[]
  invoices          CommercialInvoice[]
  exchangeRates     ExchangeRate[]
  accounts          Account[]
  transactions      Transaction[]
  permissions       Permission[]
  journalEntries    JournalEntry[]
  auditLogs         AuditLog[]
  // módulo store
  orders            Order[]
  warehouses        Warehouse[]
  accountingPeriods AccountingPeriod[]
  payments          Payment[]

  // módulo farm
  harvests         Harvest[]
  plots            Plot[]
  vehicles         Vehicle[]
  employees        Employee[]
  contracts        Contract[]
  vehicleLogs      VehicleLog[]
  plotApplications PlotApplication[]
  silos            Silo[]
  siloMovements    SiloMovement[]
  soilAnalyses     SoilAnalysis[]
  livestockBatches LivestockBatch[]
  livestockEvents  LivestockEvent[]
  certifications   Certification[]
  irrigationEvents IrrigationEvent[]
}

// ─── User ───────────────────────────────────────────────────

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String
  password           String
  role               Role      @default(OPERATOR)
  tenantId           String
  tenant             Tenant    @relation(fields: [tenantId], references: [id])
  emailVerified      DateTime?
  mustChangePassword Boolean   @default(false)
  createdAt          DateTime  @default(now())

  @@index([tenantId])
}

// ─── Customer ───────────────────────────────────────────────

model Customer {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  name         String
  document     String?
  documentType String? // RUC, CI, CPF, CNPJ
  email        String?
  phone        String?
  address      String?
  city         String?
  country      String?  @default("PY")
  category     String?  @default("retail") // retail, wholesale, vip
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  invoices CommercialInvoice[]
  orders   Order[]

  @@index([tenantId])
}

// ─── Supplier ───────────────────────────────────────────────

model Supplier {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  name         String
  businessName String?
  document     String?
  documentType String? // RUC, CI, CPF, CNPJ
  email        String?
  phone        String?
  address      String?
  city         String?
  country      String?  @default("PY")
  category     String?  @default("retail")
  isActive     Boolean  @default(true)
  paymentTerms String? // e.g. "30 days", "Net 60"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  purchaseInvoices CommercialInvoice[]
  orders           Order[]

  @@index([tenantId])
}

// ─── Product ────────────────────────────────────────────────

model Product {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  sku          String
  name         String
  price        Decimal  @db.Decimal(12, 2)
  cost         Decimal  @default(0) @db.Decimal(12, 2)
  currency     Currency @default(PYG)
  unit         String   @default("un")
  taxType      TaxType  @default(IVA_10)
  currentStock Decimal  @default(0) @db.Decimal(10, 2)
  minStock     Decimal  @default(0) @db.Decimal(10, 2)
  isActive     Boolean  @default(true)
  tags         String?
  isService    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  movements       InventoryMovement[]
  invoiceItems    InvoiceItem[]
  orderItems      OrderItem[]
  warehouseStocks WarehouseStock[]
  // módulo farm: aplicação de insumos em talhões
  applications    PlotApplication[]

  @@unique([tenantId, sku])
  @@index([tenantId])
}

// ─── Commercial Invoice ─────────────────────────────────────

model CommercialInvoice {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  type           InvoiceType
  status         InvoiceStatus @default(APPROVED)
  documentNumber String?
  timbrado       String?
  sifenCdc       String?
  sifenXmlUrl    String?
  sifenStatus    String?
  attachmentUrl  String?
  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id])
  supplierId     String?
  supplier       Supplier?     @relation(fields: [supplierId], references: [id])
  issuedAt       DateTime      @default(now())
  dueDate        DateTime?
  currency       Currency      @default(PYG)
  exchangeRate   Decimal       @default(1) @db.Decimal(12, 4)
  totalAmount    Decimal       @default(0) @db.Decimal(12, 2)
  totalUSD       Decimal?      @db.Decimal(12, 2)
  totalIva10     Decimal       @default(0) @db.Decimal(12, 2)
  totalIva5      Decimal       @default(0) @db.Decimal(12, 2)
  totalExento    Decimal       @default(0) @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  items     InvoiceItem[]
  movements InventoryMovement[]
  payments  Payment[]

  @@index([tenantId])
  @@index([customerId])
  @@index([supplierId])
}

// ─── Invoice Item ───────────────────────────────────────────

model InvoiceItem {
  id                  String            @id @default(cuid())
  commercialInvoiceId String
  commercialInvoice   CommercialInvoice @relation(fields: [commercialInvoiceId], references: [id])
  productId           String
  product             Product           @relation(fields: [productId], references: [id])
  sku                 String?
  quantity            Decimal           @db.Decimal(10, 2)
  unitPrice           Decimal           @db.Decimal(12, 2)
  totalPrice          Decimal           @db.Decimal(12, 2)
  taxType             TaxType           @default(IVA_10)
  taxBase             Decimal           @default(0) @db.Decimal(12, 2)
  taxAmount           Decimal           @default(0) @db.Decimal(12, 2)
  cost                Decimal?          @db.Decimal(12, 2)

  @@index([commercialInvoiceId])
  @@index([productId])
}

// ─── Inventory Movement ─────────────────────────────────────

model InventoryMovement {
  id                  String             @id @default(cuid())
  tenantId            String
  productId           String
  product             Product            @relation(fields: [productId], references: [id])
  type                MovementType
  quantity            Decimal            @db.Decimal(10, 2)
  unitCost            Decimal?           @db.Decimal(12, 2)
  totalCost           Decimal?           @db.Decimal(12, 2)
  reason              String?
  warehouseId         String?
  warehouse           Warehouse?         @relation(fields: [warehouseId], references: [id])
  commercialInvoiceId String?
  commercialInvoice   CommercialInvoice? @relation(fields: [commercialInvoiceId], references: [id])
  createdAt           DateTime           @default(now())

  @@index([tenantId])
  @@index([productId])
}

// ─── Exchange Rate ──────────────────────────────────────────

model ExchangeRate {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  ratePYGtoUSD Decimal  @db.Decimal(12, 4)
  ratePYGtoBRL Decimal  @db.Decimal(12, 4)
  date         DateTime @default(now())
  source       String   @default("manual")
  isManual     Boolean  @default(false)

  @@index([tenantId])
  @@index([date])
}

// ─── Account (Chart of Accounts) ────────────────────────────

model Account {
  id       String      @id @default(cuid())
  tenantId String
  tenant   Tenant      @relation(fields: [tenantId], references: [id])
  code     String
  namePt   String
  nameEs   String
  type     AccountType
  isActive Boolean     @default(true)

  journalLines JournalLine[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

// ─── Transaction ────────────────────────────────────────────

model Transaction {
  id           String          @id @default(cuid())
  tenantId     String
  tenant       Tenant          @relation(fields: [tenantId], references: [id])
  type         TransactionType
  entityId     String
  currency     Currency        @default(PYG)
  amount       Decimal         @db.Decimal(12, 2)
  exchangeRate Decimal         @default(1) @db.Decimal(12, 4)
  totalPyg     Decimal         @db.Decimal(12, 2)
  category     String?
  createdAt    DateTime        @default(now())

  @@index([tenantId])
}

// ─── Permission ─────────────────────────────────────────────

model Permission {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  action   String
  role     Role

  @@unique([action, role, tenantId])
  @@index([tenantId])
}

// ─── Journal Entry ──────────────────────────────────────────

model JournalEntry {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  number        String
  date          DateTime
  description   String
  status        String    @default("DRAFT") // POSTED, DRAFT, VOIDED
  referenceType String?
  referenceId   String?
  postedAt      DateTime?
  createdBy     String?
  createdAt     DateTime  @default(now())

  lines JournalLine[]

  @@index([tenantId])
}

// ─── Journal Line ───────────────────────────────────────────

model JournalLine {
  id             String       @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id])
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id])
  type           String // DEBIT, CREDIT
  amount         Decimal      @db.Decimal(12, 2)
  currency       String       @default("PYG")
  exchangeRate   Decimal      @default(1) @db.Decimal(12, 4)
  amountUSD      Decimal?     @db.Decimal(12, 2)
  createdAt      DateTime     @default(now())

  @@index([journalEntryId])
  @@index([accountId])
}

// ─── Audit Log ──────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  userId    String?
  action    String
  entity    String?
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([entity, entityId])
}

// ─── Payment (baixa de títulos — Contas a Receber / Pagar) ─────────

model Payment {
  id                  String            @id @default(cuid())
  tenantId            String
  tenant              Tenant            @relation(fields: [tenantId], references: [id])
  commercialInvoiceId String
  commercialInvoice   CommercialInvoice @relation(fields: [commercialInvoiceId], references: [id])
  amount              Decimal           @db.Decimal(12, 2)
  currency            Currency          @default(PYG)
  exchangeRate        Decimal           @default(1) @db.Decimal(12, 4)
  method              PaymentMethod     @default(CASH)
  paidAt              DateTime          @default(now())
  notes               String?
  journalEntryId      String?
  createdBy           String?
  createdAt           DateTime          @default(now())

  @@index([tenantId])
  @@index([commercialInvoiceId])
}

// ─── Order (Pedidos de Compra/Venda — pré-faturamento) ─────────────

enum OrderStatus {
  DRAFT
  CONFIRMED
  INVOICED
  CANCELLED
}

model Order {
  id          String      @id @default(cuid())
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  type        InvoiceType
  status      OrderStatus @default(DRAFT)
  orderNumber String
  customerId  String?
  customer    Customer?   @relation(fields: [customerId], references: [id])
  supplierId  String?
  supplier    Supplier?   @relation(fields: [supplierId], references: [id])
  expectedAt  DateTime?
  currency    Currency    @default(PYG)
  totalAmount Decimal     @default(0) @db.Decimal(12, 2)
  notes       String?
  invoiceId   String?
  createdBy   String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  items OrderItem[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([customerId])
  @@index([supplierId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Decimal @db.Decimal(10, 2)
  unitPrice Decimal @db.Decimal(12, 2)

  @@index([orderId])
}

// ─── Warehouse (Multi-depósito) ─────────────────────────────────────

model Warehouse {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  code      String
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  stocks    WarehouseStock[]
  movements InventoryMovement[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model WarehouseStock {
  id          String    @id @default(cuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  quantity    Decimal   @default(0) @db.Decimal(10, 2)

  @@unique([warehouseId, productId])
  @@index([productId])
}

// ─── Accounting Period (fechamento contábil por mês) ────────────────
// A existência de uma linha significa que o mês está FECHADO.

model AccountingPeriod {
  id       String   @id @default(cuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  year     Int
  month    Int
  closedAt DateTime @default(now())
  closedBy String?

  @@unique([tenantId, year, month])
  @@index([tenantId])
}

// ═══════════════════════════════════════════════════════════════
// Módulo farm — agronegócio (Projeto 1, Fase 2)
// Todas as bases têm estas tabelas; só Tenant.modules difere (D4).
// ═══════════════════════════════════════════════════════════════

enum VehicleLogType {
  MAINTENANCE
  FUEL
}
enum SiloMovementType {
  IN
  OUT
}
enum LivestockEventType {
  WEIGHING
  HEALTH
  MOVEMENT
}

model Harvest {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  cropType    String   // soja, milho, trigo, etc.
  startDate   DateTime
  endDate     DateTime
  status      String   @default("ACTIVE") // ACTIVE, COMPLETED, PLANNED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  plots       Plot[]
  contracts   Contract[]
  applications PlotApplication[]
  siloMovements SiloMovement[]

  @@index([tenantId])
}
model Plot {
  id           String            @id @default(cuid())
  tenantId     String
  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  name         String
  area         Decimal           @db.Decimal(10, 2)
  unit         String            @default("HECTARE") // HECTARE, ALQUEIRE
  currentCrop  String?
  status       String            @default("PLANTED") // FALLOW, PLANTED, PREPARING
  harvestId    String?
  harvest      Harvest?          @relation(fields: [harvestId], references: [id])
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  applications PlotApplication[]
  soilAnalyses SoilAnalysis[]
  irrigationEvents IrrigationEvent[]

  @@index([tenantId])
  @@index([harvestId])
}
model SoilAnalysis {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  plotId          String
  plot            Plot     @relation(fields: [plotId], references: [id])
  date            DateTime
  ph              Decimal? @db.Decimal(4, 2)
  phosphorus      Decimal? @db.Decimal(8, 2) // P, mg/dm³
  potassium       Decimal? @db.Decimal(8, 2) // K, cmolc/dm³
  organicMatter   Decimal? @db.Decimal(5, 2) // %
  recommendation  String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
  @@index([plotId])
}
model PlotApplication {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  plotId     String
  plot       Plot      @relation(fields: [plotId], references: [id])
  harvestId  String?
  harvest    Harvest?  @relation(fields: [harvestId], references: [id])
  productId  String
  product    Product   @relation(fields: [productId], references: [id])
  quantity   Decimal   @db.Decimal(10, 2)
  totalCost  Decimal?  @db.Decimal(12, 2)
  date       DateTime
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([tenantId])
  @@index([plotId])
}
model Vehicle {
  id               String       @id @default(cuid())
  tenantId         String
  tenant           Tenant       @relation(fields: [tenantId], references: [id])
  name             String
  type             String       // trator, colheitadeira, pulverizador, caminhao, etc.
  plate            String?
  status           String       @default("OPERATIONAL") // OPERATIONAL, MAINTENANCE, OUT_OF_SERVICE
  currentReading   Decimal?     @db.Decimal(12, 2)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  logs             VehicleLog[]

  @@index([tenantId])
}
model VehicleLog {
  id              String         @id @default(cuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  vehicleId       String
  vehicle         Vehicle        @relation(fields: [vehicleId], references: [id])
  type            VehicleLogType
  date            DateTime
  odometerOrHours Decimal?       @db.Decimal(12, 2)
  employeeId      String?
  employee        Employee?      @relation(fields: [employeeId], references: [id])
  notes           String?
  liters          Decimal?       @db.Decimal(10, 2)
  fuelCost        Decimal?       @db.Decimal(12, 2)
  description     String?
  maintenanceCost Decimal?       @db.Decimal(12, 2)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([tenantId])
  @@index([vehicleId])
}
model Employee {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  name        String
  role        String       // tratorista, agronomo, operador, auxiliar, etc.
  phone       String?
  status      String       @default("ACTIVE") // ACTIVE, INACTIVE, LEAVE
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  vehicleLogs      VehicleLog[]
  plotApplications PlotApplication[]
  livestockEvents  LivestockEvent[]
  irrigationEvents IrrigationEvent[]

  @@index([tenantId])
}
model Contract {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  contractNumber String
  harvestId      String?
  harvest        Harvest?  @relation(fields: [harvestId], references: [id])
  siloName       String
  grainType      String    // soja, milho, trigo, etc.
  quantity       Decimal   @db.Decimal(12, 2)
  unit           String    @default("TON") // TON, BAG, KG
  pricePerUnit   Decimal   @db.Decimal(12, 2)
  currency       Currency  @default(USD)
  status         String    @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  deliveryDate   DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  siloMovements  SiloMovement[]

  @@index([tenantId])
  @@index([harvestId])
}
model Silo {
  id           String         @id @default(cuid())
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  name         String
  capacity     Decimal        @db.Decimal(12, 2)
  unit         String         @default("TON") // TON, BAG, KG
  currentStock Decimal        @db.Decimal(12, 2) @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  movements    SiloMovement[]

  @@index([tenantId])
}
model SiloMovement {
  id           String           @id @default(cuid())
  tenantId     String
  tenant       Tenant           @relation(fields: [tenantId], references: [id])
  siloId       String
  silo         Silo             @relation(fields: [siloId], references: [id])
  type         SiloMovementType
  quantity     Decimal          @db.Decimal(12, 2)
  date         DateTime
  harvestId    String?
  harvest      Harvest?         @relation(fields: [harvestId], references: [id])
  contractId   String?
  contract     Contract?        @relation(fields: [contractId], references: [id])
  moisture     Decimal?         @db.Decimal(5, 2)
  qualityGrade String?
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([tenantId])
  @@index([siloId])
}
model LivestockBatch {
  id            String            @id @default(cuid())
  tenantId      String
  tenant        Tenant            @relation(fields: [tenantId], references: [id])
  name          String
  category      String            // bezerro, novilho, vaca, touro, boi, etc.
  quantity      Int
  averageWeight Decimal?          @db.Decimal(8, 2) // kg
  location      String?           // piquete/pasto atual
  status        String            @default("ACTIVE") // ACTIVE, SOLD
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  events        LivestockEvent[]

  @@index([tenantId])
}
model LivestockEvent {
  id          String             @id @default(cuid())
  tenantId    String
  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  batchId     String
  batch       LivestockBatch     @relation(fields: [batchId], references: [id])
  type        LivestockEventType
  date        DateTime
  weight      Decimal?           @db.Decimal(8, 2) // WEIGHING: peso médio do lote
  location    String?            // MOVEMENT: novo piquete/pasto
  description String?           // HEALTH: vacina/tratamento
  employeeId  String?
  employee    Employee?          @relation(fields: [employeeId], references: [id])
  notes       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([tenantId])
  @@index([batchId])
}
model Certification {
  id                String    @id @default(cuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  name              String    // Ex: GLOBALG.A.P, Orgânico IBD, Rainforest Alliance
  issuingBody       String?
  certificateNumber String?
  issueDate         DateTime?
  expiryDate        DateTime?
  status            String    @default("ACTIVE") // ACTIVE, EXPIRED, PENDING
  scope             String?   // Ex: "Talhões 1-5, Soja"
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([tenantId])
}
model IrrigationEvent {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  plotId         String
  plot           Plot      @relation(fields: [plotId], references: [id])
  date           DateTime
  method         String?   // pivo, gotejamento, aspersao, etc.
  durationHours  Decimal?  @db.Decimal(6, 2)
  flowRate       Decimal?  @db.Decimal(10, 2)
  volumeApplied  Decimal?  @db.Decimal(10, 2) // mm ou m³
  employeeId     String?
  employee       Employee? @relation(fields: [employeeId], references: [id])
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tenantId])
  @@index([plotId])
}
