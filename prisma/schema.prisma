  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  name           String
  type           String // trator, colheitadeira, pulverizador, caminhao, etc.
  plate          String?
  status         String       @default("OPERATIONAL") // OPERATIONAL, MAINTENANCE, OUT_OF_SERVICE
  currentReading Decimal?     @db.Decimal(12, 2)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  logs           VehicleLog[]

  @@index([tenantId])
}

model VehicleLog {
  id              String         @id @default(cuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  vehicleId       String
  vehicle         Vehicle        @relation(fields: [vehicleId], references: [id])
  type            VehicleLogType
  date            DateTime
  odometerOrHours Decimal?       @db.Decimal(12, 2)
  employeeId      String?
  employee        Employee?      @relation(fields: [employeeId], references: [id])
  notes           String?
  liters          Decimal?       @db.Decimal(10, 2)
  fuelCost        Decimal?       @db.Decimal(12, 2)
  description     String?
  maintenanceCost Decimal?       @db.Decimal(12, 2)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([tenantId])
  @@index([vehicleId])
}

model Employee {
  id               String            @id @default(cuid())
  tenantId         String
  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  name             String
  role             String // tratorista, agronomo, operador, auxiliar, etc.
  phone            String?
  status           String            @default("ACTIVE") // ACTIVE, INACTIVE, LEAVE
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  vehicleLogs      VehicleLog[]
  plotApplications PlotApplication[]
  livestockEvents  LivestockEvent[]
  irrigationEvents IrrigationEvent[]

  @@index([tenantId])
}

model Contract {
  id             String         @id @default(cuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  contractNumber String
  harvestId      String?
  harvest        Harvest?       @relation(fields: [harvestId], references: [id])
  siloName       String
  grainType      String // soja, milho, trigo, etc.
  quantity       Decimal        @db.Decimal(12, 2)
  unit           String         @default("TON") // TON, BAG, KG
  pricePerUnit   Decimal        @db.Decimal(12, 2)
  currency       Currency       @default(USD)
  status         String         @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  deliveryDate   DateTime?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  siloMovements  SiloMovement[]

  @@index([tenantId])
  @@index([harvestId])
}

model Silo {
  id           String         @id @default(cuid())
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  name         String
  capacity     Decimal        @db.Decimal(12, 2)
  unit         String         @default("TON") // TON, BAG, KG
  currentStock Decimal        @default(0) @db.Decimal(12, 2)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  movements    SiloMovement[]

  @@index([tenantId])
