// ─── Módulo food (restaurantes e lanchonetes) ───────────────────────

/// Onde um item é preparado. Serve para o item aparecer no ecrã certo: o
/// hambúrguer na chapa, a caipirinha no bar. Uma bebida engarrafada não passa
/// por preparação nenhuma e vai direta para entregue.
enum PreparoArea {
  COZINHA
  BAR
  CHAPA
  SEM_PREPARO
}

/// Estado de uma mesa no salão. LIVRE e OCUPADA são derivados da existência de
/// comanda aberta; RESERVADA e INATIVA são decisões de quem gere a casa e por
/// isso ficam guardadas.
enum MesaEstado {
  LIVRE
  RESERVADA
  INATIVA
}

enum ComandaTipo {
  MESA
  BALCAO
  DELIVERY
}

enum ComandaEstado {
  ABERTA
  FECHADA
  CANCELADA
}

/// Ciclo de vida de um item dentro da comanda.
///
/// LANCADO é o item escrito mas ainda não enviado — dá tempo ao empregado de
/// corrigir antes de a cozinha começar. Depois de EM_PREPARO já há comida a ser
/// feita, e cancelar passa a ter custo.
enum ComandaItemEstado {
  LANCADO
  EM_PREPARO
  PRONTO
  ENTREGUE
  CANCELADO
}

model RestaurantTable {
  id       String     @id @default(cuid())
  tenantId String
  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  /// Como a casa lhe chama: "12", "Varanda 3", "Balcão 1".
  nome     String
  /// Zona do salão, para agrupar no ecrã: salão, varanda, mezanino.
  zona     String?
  lugares  Int        @default(2)
  estado   MesaEstado @default(LIVRE)

  comandas Comanda[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, nome])
  @@index([tenantId])
}

/// O que num restaurante se chama comanda e numa lanchonete é o pedido do
/// balcão: uma conta aberta que recebe itens ao longo do tempo e só no fim se
/// transforma em documento fiscal.
model Comanda {
  id       String        @id @default(cuid())
  tenantId String
  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  /// Sequencial por cliente, para se poder chamar pelo número em voz alta.
  numero   Int
  tipo     ComandaTipo   @default(MESA)
  estado   ComandaEstado @default(ABERTA)

  mesaId String?
  mesa   RestaurantTable? @relation(fields: [mesaId], references: [id])

  /// Opcional de propósito: a maioria das contas de balcão não tem cliente
  /// identificado, e exigir um afastaria as pessoas do sistema.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  /// Quantas pessoas na mesa. Só serve para dividir a conta.
  pessoas Int @default(1)

  /// Percentagem de serviço acordada com o cliente no momento de fechar.
  /// Guardada na comanda e não numa definição global: uma casa pode não
  /// cobrar serviço no balcão e cobrar na esplanada, e o valor cobrado tem de
  /// continuar legível daqui a um ano.
  servicoPct Decimal @default(0) @db.Decimal(5, 2)

  /// Desconto em valor absoluto, na moeda da conta.
  desconto Decimal @default(0) @db.Decimal(12, 2)

  notas String?

  /// Fatura em que a comanda foi fechada, quando foi.
  invoiceId String?

  abertaPor String?
  abertaEm  DateTime  @default(now())
  fechadaEm DateTime?

  itens ComandaItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, numero])
  @@index([tenantId, estado])
  @@index([mesaId])
}

model ComandaItem {
  id        String  @id @default(cuid())
  comandaId String
  comanda   Comanda @relation(fields: [comandaId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantidade Decimal @db.Decimal(10, 2)
  /// Copiado do produto no momento do lançamento. Se o preço da casa mudar
  /// amanhã, a conta de hoje continua a dizer o que se cobrou hoje.
  precoUnit  Decimal @db.Decimal(12, 2)

  /// "sem cebola", "ao ponto". Vai para a cozinha tal e qual.
  observacao String?

  estado ComandaItemEstado @default(LANCADO)
  area   PreparoArea       @default(COZINHA)

  enviadoEm DateTime?
  prontoEm  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([comandaId])
  @@index([productId])
}

/// A face de um produto no cardápio.
///
/// O produto continua a ser a entidade de estoque e de fatura — não se duplica.
/// O que se acrescenta é o que só interessa ao salão: em que secção do menu
/// aparece, por que ordem, para onde vai preparar-se, e se hoje há.
model MenuItem {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  /// Único: um produto tem uma face no cardápio, não várias. Duas entradas
  /// para o mesmo prato seriam dois preços a divergir com o tempo.
  productId String  @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Secção do menu: Entradas, Pratos, Bebidas, Sobremesas.
  seccao String
  ordem  Int         @default(0)
  area   PreparoArea @default(COZINHA)

  /// Acabou hoje. Diferente de desativar o produto: amanhã há outra vez, e o
  /// histórico de vendas não se toca.
  disponivel Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, productId])
  @@index([tenantId, seccao])
}
