  @@index([siloId])
}

model LivestockBatch {
  id            String           @id @default(cuid())
  tenantId      String
  tenant        Tenant           @relation(fields: [tenantId], references: [id])
  name          String
  category      String // bezerro, novilho, vaca, touro, boi, etc.
  quantity      Int
  averageWeight Decimal?         @db.Decimal(8, 2) // kg
  location      String? // piquete/pasto atual
  status        String           @default("ACTIVE") // ACTIVE, SOLD
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  events        LivestockEvent[]

  @@index([tenantId])
}

model LivestockEvent {
  id          String             @id @default(cuid())
  tenantId    String
  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  batchId     String
  batch       LivestockBatch     @relation(fields: [batchId], references: [id])
  type        LivestockEventType
  date        DateTime
  weight      Decimal?           @db.Decimal(8, 2) // WEIGHING: peso médio do lote
  location    String? // MOVEMENT: novo piquete/pasto
  description String? // HEALTH: vacina/tratamento
  employeeId  String?
  employee    Employee?          @relation(fields: [employeeId], references: [id])
  notes       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([tenantId])
  @@index([batchId])
}

model Certification {
  id                String    @id @default(cuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  name              String // Ex: GLOBALG.A.P, Orgânico IBD, Rainforest Alliance
  issuingBody       String?
  certificateNumber String?
  issueDate         DateTime?
  expiryDate        DateTime?
  status            String    @default("ACTIVE") // ACTIVE, EXPIRED, PENDING
  scope             String? // Ex: "Talhões 1-5, Soja"
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([tenantId])
}

model IrrigationEvent {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  plotId        String
  plot          Plot      @relation(fields: [plotId], references: [id])
  date          DateTime
  method        String? // pivo, gotejamento, aspersao, etc.
  durationHours Decimal?  @db.Decimal(6, 2)
  flowRate      Decimal?  @db.Decimal(10, 2)
  volumeApplied Decimal?  @db.Decimal(10, 2) // mm ou m³
  employeeId    String?
  employee      Employee? @relation(fields: [employeeId], references: [id])
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId])
  @@index([plotId])
}

